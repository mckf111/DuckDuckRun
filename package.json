{
  "name": "jinling-run",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "check": "npm run test:syntax && npm run test:resources",
    "build": "node tools/build_static.mjs",
    "typecheck": "node tools/e2e/check_syntax.mjs",
    "lint": "node tools/e2e/check_syntax.mjs",
    "test:syntax": "node tools/e2e/check_syntax.mjs",
    "test:logic": "node --test tests/rules.test.js tests/beam.test.js tests/rhythm.test.js tests/runtime.test.js",
    "test:save": "node --test tests/migration.test.js tests/save-io.test.js",
    "test:resources": "node --test tests/content.test.js",
    "test:browser": "node tools/e2e/browser_test.mjs",
    "test:dist": "node tools/e2e/check_dist.mjs",
    "test:size": "node tools/e2e/check_size_budget.mjs",
    "test": "npm run check && npm run test:logic && npm run test:save && npm run test:browser",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:dist && npm run test:size"
  }
}
